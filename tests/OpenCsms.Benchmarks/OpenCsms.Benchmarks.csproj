<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenCsms.Benchmarks</RootNamespace>

    <IsPackable>false</IsPackable>
    <!-- The harness has its own host-building entry point; the test SDK's generated entry point would
         collide with it and confuse the worker resolver. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- The harness process runs the API's entry point through the host factory resolver, so it needs
         the same build metadata a hosted app carries: the resolver's content-root discovery reads it
         when the entry point runs without arguments. -->
    <GenerateBuildMetadataAttributes>true</GenerateBuildMetadataAttributes>
    <!-- The Web SDK supplies the ASP.NET Core framework reference implicitly. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="ProtoTest.AspNetCore" Version="1.1.0" />
    <PackageReference Include="ProtoTest.Core" Version="1.1.0" />
    <PackageReference Include="ProtoTest.Hosting" Version="1.1.0" />
    <PackageReference Include="ProtoTest.Messaging.RabbitMq" Version="1.1.0" />
    <PackageReference Include="ProtoTest.Rest" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenCsms.Api\OpenCsms.Api.csproj" />
    <ProjectReference Include="..\..\src\OpenCsms.Billing.Worker\OpenCsms.Billing.Worker.csproj" />
    <ProjectReference Include="..\..\src\OpenCsms.Contracts\OpenCsms.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
