<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- One reference downstream: Infrastructure sees the application's ports, and the domain
         through it. Nothing in Application or Domain sees this project. -->
    <ProjectReference Include="..\OpenCsms.Application\OpenCsms.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The suite's publisher-recovery test closes a connection under the publisher and asserts the
         replacement, which needs the internal connect seam on RabbitMqEventPublisher. -->
    <InternalsVisibleTo Include="OpenCsms.Suite" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <!-- The design-time factory above is what 'dotnet ef migrations' uses; the tools need this in the
         project they run against, and it is not part of the built application (PrivateAssets=all). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
