<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- The published shape: ProtoTest packages resolve from nuget.org like every other package.
       Until ProtoTest 1.1.0 is published, a maintainer restores from the sibling checkout's local
       feed instead: copy NuGet.local.config.example to NuGet.local.config (gitignored) and every
       dotnet command picks it up automatically (see Directory.Build.props and README, "Packages"). -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
