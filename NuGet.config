<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- While 1.1 is under development, the ProtoTest build packed by ../ProtoTest/eng/pack.ps1 wins. -->
    <add key="prototest-local" value="../ProtoTest/artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- ProtoTest packages always come from the local build: during 1.1 development the branch and the
       published 1.0.1 share a version number, so the source must not be left to chance. Once 1.1 is
       published this mapping goes away and nuget.org serves them. -->
  <packageSourceMapping>
    <packageSource key="prototest-local">
      <package pattern="ProtoTest.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
